#!/usr/bin/env python3
"""butaca-rec — inspect, verify and compare recordings (restructure spec §5.3–§5.6).

    butaca-rec info  <dir>                 frames, event frames, present count, header
    butaca-rec check <dir>                 every string value is in the synthetic alphabet
    butaca-rec diff  <a> <b> [--unsafe]    the st streams, pointwise; --safe is the default
    butaca-rec import <dir> <name>         copy a CHECKED recording into tests/fixtures/replay/<name>
    butaca-rec rebaseline <dir> <name> --log <events.log> [--reason <text>]
                                              REPLACE fixture <name> with a new recording, allowed only
                                              with a DIVERGENCE RECORD derived from the replay's own log
                                              (spec §5.5). A non-anchor needs only the record; an ANCHOR
                                              additionally needs a written --reason (both are refused if
                                              either piece is missing)
    butaca-rec rerecord <dir> <name>       REPLACE fixture <name> after a SHAPE bump, allowed only when
                                              the committed fixture's (schema, state_fp) differs from the
                                              new recording's — i.e. the old artifact can no longer be
                                              LOADED at all. Permitted for an anchor; see below

A recording is `manifest.json` + `rec-NNNN.jsonl` (ui/rec.rs). `diff` prints frame indices, event
kinds and hashes and never a string payload unless `--unsafe` is given, because a recording taken
against a real server is private and the printer's output lands in transcripts. `import` refuses
anything `check` refuses; the committed fixture is what tests/test_harness.py verifies on every
`make check`, and the outbound guard applies the same alphabet before a push.

**`rerecord` vs `rebaseline`, which is the whole reason there are two verbs.** A rebaseline says
"the behaviour changed and the new stream is the truth" — a judgement, which is why it costs a
divergence record the replay itself produced, and why an ANCHOR needs a written `--reason` on top
of that record (spec §5.5): an anchor exists precisely to make a silent behaviour drift impossible,
so re-baselining one demands BOTH the machine's own witness that the artifact replays and diverges
(the `replay: diverge` line, never the caller's word) AND a written justification, saved in the
fixture's `divergence.json` as the trail of a deliberate change. A non-anchor rebaseline still
needs only the divergence record. A rerecord says something weaker and machine-checkable: the
committed artifact cannot be loaded at all, because the state SHAPE moved (`schema` or `state_fp`)
or the INITIAL moved (`init.hash`, which covers the session identity and so follows a rename), and
the decoder refuses it before it can grade anything at all. No divergence record can exist because
no replay can run. Nothing is being accepted, because nothing could be compared. That is why an
anchor may be re-recorded without a reason, and re-baselined only WITH one, and why rerecord
verifies the condition itself rather than trusting the caller: it reads all three fields and refuses
when none of them moved — which is exactly the case a rebaseline is for. The anchor flag is
preserved across both replacements, so a re-recorded or re-baselined anchor is still an anchor.
"""
import json
import os
import re
import shutil
import sys
from collections import Counter

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
FIXTURES = os.path.join(ROOT, "tests", "fixtures", "replay")
MAX_METRIC_TEXT_BYTES = 16384   # ui/rec.rs: MetricKey::valid
U32_MAX = (1 << 32) - 1
U64_MAX = (1 << 64) - 1
I32_MIN = -(1 << 31)
I32_MAX = (1 << 31) - 1


def load(d):
    with open(os.path.join(d, "manifest.json"), encoding="utf-8") as f:
        header = json.load(f)
    frames = {}
    order = []
    segs = sorted(n for n in os.listdir(d) if n.startswith("rec-") and n.endswith(".jsonl"))
    for n in segs:
        with open(os.path.join(d, n), encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                rec = json.loads(line)
                fr = rec["f"]
                if fr not in frames:
                    frames[fr] = {"f": fr, "kinds": [], "st": None, "present": None}
                    order.append(fr)
                frames[fr]["kinds"].append(rec["t"])
                if rec["t"] == "st":
                    frames[fr]["st"] = rec.get("hash")
                if rec["t"] == "present":
                    frames[fr]["present"] = rec.get("bit")
    return header, [frames[f] for f in order]


def alphabet():
    with open(os.path.join(FIXTURES, "ALPHABET.json"), encoding="utf-8") as f:
        a = json.load(f)
    return frozenset(a.get("literals", [])), [re.compile("^(?:%s)$" % p) for p in a.get("patterns", [])]


def strings(node, out):
    if isinstance(node, str):
        out.append(node)
    elif isinstance(node, dict):
        for v in node.values():
            strings(v, out)
    elif isinstance(node, list):
        for v in node:
            strings(v, out)


def _canonical_int(value, low, high):
    """JSON bools/floats are not integers in the recording wire format."""
    return type(value) is int and low <= value <= high


def _unique_object(pairs):
    """Build a JSON object only when every field has one spelling."""
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON field")
        result[key] = value
    return result


def strict_json(text):
    return json.loads(text, object_pairs_hook=_unique_object)


def metric_strings(doc):
    """(valid, decoded text values) for one canonical top-level metrics record.

    MetricKey::Width deliberately stores raw bytes so private recordings remain byte-exact and
    can distinguish non-UTF-8 C strings.  A *public* synthetic fixture has a narrower contract:
    only the canonical ui/rec.rs envelope is decoded, and its bytes must be bounded UTF-8 text
    that the closed alphabet can grade.  Numeric arrays anywhere else are application data, not
    an implicit string encoding, and are not interpreted here.
    """
    if not isinstance(doc, dict) or doc.get("t") != "metrics":
        return True, []
    if set(doc) != {"f", "t", "q", "bits"}:
        return False, []
    if not _canonical_int(doc["f"], 0, U64_MAX) or not _canonical_int(doc["bits"], 0, U32_MAX):
        return False, []
    query = doc.get("q")
    if not isinstance(query, dict):
        return False, []
    kind = query.get("kind")
    if kind == "Width":
        if set(query) != {"kind", "text", "sz", "bold"}:
            return False, []
        text = query["text"]
        if (not isinstance(text, list) or len(text) > MAX_METRIC_TEXT_BYTES
                or not _canonical_int(query["sz"], I32_MIN, I32_MAX)
                or type(query["bold"]) is not bool
                or any(not _canonical_int(value, 0, 255) for value in text)
                or 0 in text):
            return False, []
        try:
            return True, [bytes(text).decode("utf-8", errors="strict")]
        except UnicodeDecodeError:
            return False, []
    if kind in ("Cap", "Line"):
        if set(query) != {"kind", "sz"} or not _canonical_int(query["sz"], I32_MIN, I32_MAX):
            return False, []
        return True, []
    return False, []


def check(d):
    lits, pats = alphabet()
    bad = 0
    for n in sorted(os.listdir(d)):
        p = os.path.join(d, n)
        if not (n == "manifest.json" or (n.startswith("rec-") and n.endswith(".jsonl"))):
            continue
        with open(p, encoding="utf-8") as f:
            text = f.read()
        try:
            docs = [strict_json(text)] if n.endswith(".json") else [strict_json(l) for l in text.splitlines() if l.strip()]
        except (ValueError, json.JSONDecodeError):
            bad += 1
            print("  %s: malformed or duplicate-key JSON" % n)
            continue
        for doc in docs:
            vals = []
            strings(doc, vals)
            metric_ok, metric_vals = metric_strings(doc)
            vals.extend(metric_vals)
            if not metric_ok:
                bad += 1
                print("  %s: a malformed public metric record" % n)
            for v in vals:
                if v in lits or any(pt.fullmatch(v) for pt in pats):
                    continue
                bad += 1
                # the value is NOT printed: that is the leak by a shorter route
                print("  %s: a string of %d chars outside the alphabet" % (n, len(v)))
    return bad


def cmd_info(d):
    header, frames = load(d)
    features = header.get("features", [])
    # Validate the container first: iterating a scalar string would disclose an
    # otherwise rejected value as individually permitted characters.
    features_text = ",".join(safe_value(v) for v in features) if isinstance(features, list) else "<redacted>"
    ev = sum(1 for f in frames if f["st"] is not None)
    pres = sum(1 for f in frames if f["present"])
    print("recording: %s" % d)
    print("  schema=%s state_fp=%s build=%s features=%s" % (
        safe_value(header.get("schema")), safe_value(header.get("state_fp")),
        safe_value(header.get("build")), features_text))
    print("  frames=%d event_frames=%d presented=%d" % (len(frames), ev, pres))
    counts = Counter(kind for frame in frames for kind in frame["kinds"])
    print("  inputs=%d effects=%d results=%d landings=%d lifecycle=%d" % (
        counts["in"], counts["eff"], counts["async"], counts["land"], counts["life"]))
    return 0


def cmd_check(d):
    bad = check(d)
    print("%s: %s" % (d, "synthetic" if bad == 0 else "%d string(s) outside the alphabet" % bad))
    return 0 if bad == 0 else 1


def safe_value(value):
    """Only protocol/synthetic strings can reach the default diagnostic printer."""
    if value is None or type(value) in (int, bool):
        return str(value)
    lits, pats = alphabet()
    if isinstance(value, str) and (value in lits or any(p.fullmatch(value) for p in pats)):
        return value
    return "<redacted>"


def cmd_diff(a, b, unsafe):
    _, fa = load(a)
    _, fb = load(b)
    ia = {f["f"]: f for f in fa}
    ib = {f["f"]: f for f in fb}
    n = 0
    for fr in sorted(set(ia) | set(ib)):
        x, y = ia.get(fr), ib.get(fr)
        if x is None or y is None:
            print("only-in-%s f=%d" % ("a" if y is None else "b", fr))
            n += 1
            continue
        if x["st"] != y["st"]:
            kinds = ",".join(sorted({safe_value(k) for k in x["kinds"] + y["kinds"]}))
            print("diverge f=%d a=%s b=%s kinds=[%s]" % (fr, safe_value(x["st"]), safe_value(y["st"]), kinds))
            n += 1
        if x["present"] != y["present"]:
            print("present f=%d a=%s b=%s" % (fr, safe_value(x["present"]), safe_value(y["present"])))
            n += 1
    if unsafe:
        print("(--unsafe prints nothing more today: payloads are compared as hashes)")
    print("%d difference(s)" % n)
    return 0 if n == 0 else 1


def cmd_import(d, name):
    if check(d):
        print("refused: the recording is not synthetic; it stays in %s" % d)
        return 1
    if not re.match(r"^[a-z0-9][a-z0-9-]{0,40}$", name):
        print("refused: a fixture name is [a-z0-9-]")
        return 2
    dst = os.path.join(FIXTURES, name)
    if os.path.exists(dst):
        print("refused: %s exists (use --rebaseline through the replay driver, with a divergence record)" % dst)
        return 1
    os.makedirs(dst)
    for n in sorted(os.listdir(d)):
        if n == "manifest.json" or (n.startswith("rec-") and n.endswith(".jsonl")):
            shutil.copy(os.path.join(d, n), os.path.join(dst, n))
    print("imported %s -> %s" % (d, dst))
    return 0


def fixture_init_hash(d):
    """The initial's hash from a recording's manifest, or None when it cannot be read.

    `Recording::parse` accepts a stream by schema and state shape, but the sim decodes the
    recording's `init` through `Initial::decode`, which refuses a hash this build does not
    reproduce. That hash covers the session identity, so a rename moves it while schema and
    state_fp stay put — the artifact then cannot be graded at all, which is the same situation
    a shape move creates.
    """
    try:
        with open(os.path.join(d, "manifest.json"), encoding="utf-8") as f:
            return json.load(f)["init"]["hash"]
    except (OSError, ValueError, KeyError, TypeError):
        return None


def cmd_rerecord(d, name):
    """Replace a fixture whose committed shape can no longer be loaded (see the module doc)."""
    if check(d):
        print("refused: the recording is not synthetic; it stays in %s" % d)
        return 1
    dst = os.path.join(FIXTURES, name)
    old_manifest = os.path.join(dst, "manifest.json")
    if not os.path.isdir(dst) or not os.path.exists(old_manifest):
        print("refused: no fixture %s to re-record (use import)" % name)
        return 2
    with open(old_manifest, encoding="utf-8") as f:
        old = json.load(f)
    with open(os.path.join(d, "manifest.json"), encoding="utf-8") as f:
        new = json.load(f)
    old_shape = (old.get("schema"), old.get("state_fp"))
    new_shape = (new.get("schema"), new.get("state_fp"))
    old_init = fixture_init_hash(dst)
    new_init = fixture_init_hash(d)
    if old_shape == new_shape and old_init == new_init:
        # The committed fixture still LOADS, so a replay can grade it and a divergence record can
        # exist. Replacing it here would be accepting a behaviour change with no evidence, which
        # is the one thing this tool exists to prevent.
        print("refused: %s still loads (schema=%s state_fp=%s init=%s unchanged) — this is a "
              "rebaseline, not a re-record" % (name, new_shape[0], new_shape[1], new_init))
        return 1
    was_anchor = bool(old.get("anchor"))
    shutil.rmtree(dst)
    os.makedirs(dst)
    for n in sorted(os.listdir(d)):
        if n == "manifest.json" or (n.startswith("rec-") and n.endswith(".jsonl")):
            shutil.copy(os.path.join(d, n), os.path.join(dst, n))
    if was_anchor:
        # An anchor stays an anchor: the shape bump is why it could be replaced, not a demotion.
        with open(os.path.join(dst, "manifest.json"), encoding="utf-8") as f:
            m = json.load(f)
        m["anchor"] = True
        with open(os.path.join(dst, "manifest.json"), "w", encoding="utf-8") as f:
            json.dump(m, f, indent=1, sort_keys=True)
            f.write("\n")
    moved = []
    if old_shape != new_shape:
        moved.append("shape %s -> %s" % (old_shape, new_shape))
    if old_init != new_init:
        moved.append("initial %s -> %s" % (old_init, new_init))
    print("re-recorded %s: %s%s"
          % (name, "; ".join(moved), " (anchor preserved)" if was_anchor else ""))
    return 0


DIVERGE_RE = re.compile(r"^replay: diverge f=(\d+) expected=(0x[0-9a-f]+) got=(0x[0-9a-f]+) inputs=(\d+)")
DONE_RE = re.compile(r"^replay: done .*verdict=(SAME|DIVERGED)")
REFUSED_RE = re.compile(r"^replay: REFUSED")
RESULT_DIFFS_RE = re.compile(r"\bresult_diffs=(\d+)\b")
EFFECT_DIFFS_RE = re.compile(r"\beffect_diffs=(\d+)\b")
INPUT_DIFFS_RE = re.compile(r"\binput_diffs=(\d+)\b")


def divergence_record(fixture_dir, log_path, allow_refused=False):
    """The record CI verifies before a rebaseline lands (spec §5.5): the first diverging frame,
    the event kinds recorded on it, and both state-shape fingerprints — derived from the replay
    driver's OWN log lines, which is the only witness that a divergence was observed rather than
    asserted. Returns (record, reason) with one of them None.

    `allow_refused` admits a replay that diverged on a state frame and then REFUSED instead of
    reaching `done` — the `replay measurement table miss` a newly measured string causes — where
    the `replay: diverge` line is still the evidence and the refusal the confirmation the artifact
    no longer grades cleanly. Only the anchor re-baseline passes it; an ordinary rebaseline still
    demands a clean `replay: done … verdict=DIVERGED`."""
    header, frames = load(fixture_dir)
    with open(log_path, encoding="utf-8") as f:
        lines = f.read().splitlines()
    verdict = None
    first = None
    refused = None
    for ln in lines:
        # The adoption record below proves a STATE divergence only. Do not erase a result
        # mismatch by selecting some later state hash from the same log. Either witness is
        # sufficient for refusal, including an inconsistent summary or missing detail lines.
        if ln.startswith("replay: result diverge "):
            return None, "result divergences need an adapter adoption record; state-only rebaseline is refused"
        if ln.startswith("replay: effect diverge "):
            return None, "effect divergences need an effect adoption record; state-only rebaseline is refused"
        if ln.startswith("replay: input diverge "):
            return None, "input divergences need an input adoption record; state-only rebaseline is refused"
        m = DONE_RE.match(ln)
        if m:
            results = RESULT_DIFFS_RE.search(ln)
            if results and int(results.group(1)) != 0:
                return None, "result divergences need an adapter adoption record; state-only rebaseline is refused"
            effects = EFFECT_DIFFS_RE.search(ln)
            if effects and int(effects.group(1)) != 0:
                return None, "effect divergences need an effect adoption record; state-only rebaseline is refused"
            inputs = INPUT_DIFFS_RE.search(ln)
            if inputs and int(inputs.group(1)) != 0:
                return None, "input divergences need an input adoption record; state-only rebaseline is refused"
            verdict = m.group(1)
        m = DIVERGE_RE.match(ln)
        if m and first is None:
            first = m
        if REFUSED_RE.match(ln):
            refused = ln
    if verdict != "DIVERGED" and not (allow_refused and first is not None and refused is not None):
        return None, "the log carries no `replay: done … verdict=DIVERGED` line"
    if first is None:
        return None, "the log reports DIVERGED but carries no `replay: diverge` line"
    fr = int(first.group(1))
    by_f = {x["f"]: x for x in frames}
    if fr not in by_f or by_f[fr]["st"] is None:
        return None, "the first diverging frame %d is not a graded frame of this fixture" % fr
    if by_f[fr]["st"] != int(first.group(2), 16):
        return None, "the log's expected hash at f=%d is not this fixture's" % fr
    preceding = [k for k in by_f[fr]["kinds"] if k == "in"]
    return {
        "first_frame": fr,
        "preceding_event_kinds": preceding,
        "expected": first.group(2),
        "got": first.group(3),
        "from_state_fp": header.get("state_fp"),
    }, None


def cmd_rebaseline(d, name, log_path, reason):
    dst = os.path.join(FIXTURES, name)
    if not os.path.isdir(dst):
        print("refused: no fixture %s to rebaseline (use import)" % name)
        return 1
    is_anchor = False
    with open(os.path.join(dst, "manifest.json"), encoding="utf-8") as f:
        is_anchor = bool(json.load(f).get("anchor"))
    if is_anchor and reason is None:
        print("refused: %s is an ANCHOR fixture; re-baselining an anchor needs BOTH a divergence "
              "record (--log) and a written reason (--reason)" % name)
        return 1
    if log_path is None:
        print("refused: a rebaseline needs a divergence record (--log <the replay's events log>)")
        return 1
    record, why = divergence_record(dst, log_path, allow_refused=is_anchor)
    if record is None:
        print("refused: %s" % why)
        return 1
    if check(d):
        print("refused: the new recording is not synthetic; it stays in %s" % d)
        return 1
    with open(os.path.join(d, "manifest.json"), encoding="utf-8") as f:
        record["to_state_fp"] = json.load(f).get("state_fp")
    if reason:
        record["reason"] = reason
    for n in os.listdir(dst):
        if n == "manifest.json" or (n.startswith("rec-") and n.endswith(".jsonl")):
            os.remove(os.path.join(dst, n))
    for n in sorted(os.listdir(d)):
        if n == "manifest.json" or (n.startswith("rec-") and n.endswith(".jsonl")):
            shutil.copy(os.path.join(d, n), os.path.join(dst, n))
    if is_anchor:
        # An anchor stays an anchor: the deliberate re-baseline is why it could be replaced, not
        # a demotion. The reason lives in divergence.json beside the divergence record.
        with open(os.path.join(dst, "manifest.json"), encoding="utf-8") as f:
            m = json.load(f)
        m["anchor"] = True
        with open(os.path.join(dst, "manifest.json"), "w", encoding="utf-8") as f:
            json.dump(m, f, indent=1, sort_keys=True)
            f.write("\n")
    with open(os.path.join(dst, "divergence.json"), "w", encoding="utf-8") as f:
        json.dump(record, f, indent=2, sort_keys=True)
        f.write("\n")
    print("rebaselined %s from %s (first diverging frame %d)%s" % (
        name, d, record["first_frame"], " - anchor preserved" if is_anchor else ""))
    return 0


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd = argv[1]
    if cmd == "info" and len(argv) == 3:
        return cmd_info(argv[2])
    if cmd == "check" and len(argv) == 3:
        return cmd_check(argv[2])
    if cmd == "diff" and len(argv) >= 4:
        return cmd_diff(argv[2], argv[3], "--unsafe" in argv[4:])
    if cmd == "import" and len(argv) == 4:
        return cmd_import(argv[2], argv[3])
    if cmd == "rerecord" and len(argv) == 4:
        return cmd_rerecord(argv[2], argv[3])
    if cmd == "rebaseline" and len(argv) >= 4:
        log_path = argv[argv.index("--log") + 1] if "--log" in argv[4:] and argv.index("--log") + 1 < len(argv) else None
        reason = argv[argv.index("--reason") + 1] if "--reason" in argv[4:] and argv.index("--reason") + 1 < len(argv) else None
        return cmd_rebaseline(argv[2], argv[3], log_path, reason)
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
